# Copy to .env (gitignored) and fill in. Never commit .env.
#
# Layer 1 (demo lifecycle only) needs nothing here — the file just has to
# exist, because the Makefile passes --env-file .env to docker compose and
# compose errors on a missing env file. The rest is forward-looking.

# Required once the agent exists. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Models. The course guide's L11 lab found gpt-4o-mini unreliable as a
# coordinator; gpt-4.1-mini worked. The judge must be a DIFFERENT model
# family from the agent, so its agreement means something.
COMMANDER_MODEL=openai/gpt-4.1-mini
SPECIALIST_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=google/gemini-3.1-flash-lite

# stdio while developing (the graph spawns each server as a subprocess),
# http inside Docker (each server is its own container).
MCP_TRANSPORT=stdio

# Budgets, enforced by hooks/pre_tool.py. Harmful actions must stay at zero.
MAX_TOOL_CALLS_PER_INCIDENT=10
MAX_USD_PER_INCIDENT=0.50

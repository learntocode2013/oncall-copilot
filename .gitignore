.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

.env
.DS_Store
.idea/

# `artifacts/*`, not `artifacts/`: Git does not descend into an excluded
# DIRECTORY, so a `!` rule for anything inside one can never match.
artifacts/*
# ...except the retrieval experiment records. These ARE the graded evidence for
# the before/after Recall@5 result: each carries the query-set hash, the model id
# and revision, and every per-query rank. A number quoted in the report with no
# committed record behind it cannot be checked by anyone, us included.
# Agent run records under artifacts/runs/ stay ignored -- numerous, regenerated.
!artifacts/retrieval/
!artifacts/retrieval/*.json

docs/submission/
scratch/

# per-machine make overrides (MODE=minimal etc.)
deploy/local.mk
